+package com.guichaguri.trackplayer.audio;
+
+import androidx.annotation.NonNull;
+import androidx.media3.common.C;
+import androidx.media3.common.audio.AudioProcessor;
+import androidx.media3.common.audio.BaseAudioProcessor;
+import androidx.media3.common.util.UnstableApi;
+
+import java.nio.ByteBuffer;
+
+/**
+ * 自建 20 段图形均衡器：内部串联 20 个 biquad peaking 滤波器（Direct Form II Transposed）。
+ * 频段中心频率（Hz）：
+ * 20 31 45 63 80 125 250 500 800 1000 1250 2000 3150 4000 6300 8000 10000 12500 16000 20000
+ *
+ * 设计要点：
+ * - onConfigure 始终返回输入格式（恒 active），关闭时内部旁路，规避 media3 运行时切换 active 不生效的问题。
+ * - 同时支持 ENCODING_PCM_16BIT（主路径）与 ENCODING_PCM_FLOAT（防御）。
+ * - 每声道独立 biquad 状态；onFlush 清零延迟寄存器，杜绝 seek/换曲残响。
+ * - 增益/系数更新采用「复制-替换」+ volatile，音频线程无锁读取。
+ */
+@UnstableApi
+public class EqualizerAudioProcessor extends BaseAudioProcessor {
+
+    /** 20 段中心频率（Hz） */
+    public static final double[] BAND_FREQS = {
+        20, 31, 45, 63, 80, 125, 250, 500, 800, 1000,
+        1250, 2000, 3150, 4000, 6300, 8000, 10000, 12500, 16000, 20000
+    };
+    public static final int BAND_COUNT = BAND_FREQS.length;
+    /** Q 因子（约等于根号 2，约 1 倍频程带宽） */
+    public static final double Q = 1.41;
+
+    /** 单段归一化系数（a0 = 1） */
+    private static final class CoefSet {
+        final float b0, b1, b2, a1, a2;
+        CoefSet(double b0, double b1, double b2, double a1, double a2) {
+            this.b0 = (float) b0;
+            this.b1 = (float) b1;
+            this.b2 = (float) b2;
+            this.a1 = (float) a1;
+            this.a2 = (float) a2;
+        }
+    }
+
+    /** 全 0 增益（旁路）时的系数快照，避免重复构建 */
+    private static final CoefSet[] FLAT = new CoefSet[BAND_COUNT];
+    static {
+        for (int i = 0; i < BAND_COUNT; i++) FLAT[i] = new CoefSet(1, 0, 0, 0, 0);
+    }
+
+    /** 来自 RN bridge 的增益（dB），volatile 引用整体替换 */
+    private volatile double[] gainsDb = new double[BAND_COUNT];
+    private volatile boolean enabled = false;
+
+    /** 当前生效系数快照（按采样率构建） */
+    private volatile CoefSet[] coefs = FLAT;
+    private volatile int activeSampleRate = -1;
+    private volatile int activeEncoding = C.ENCODING_PCM_16BIT;
+
+    /** 每声道、每段 DF2T 状态：state[ch][band] = {z1, z2} */
+    private float[][][] state;
+    private int channelCount = 0;
+
+    private final Object lock = new Object();
+
+    /** 设置是否启用均衡（关闭则内部旁路）。可由 RN bridge 线程调用 */
+    public void setEnabled(boolean enabled) {
+        synchronized (lock) {
+            this.enabled = enabled;
+            rebuildCoefficientsLocked();
+        }
+    }
+
+    /**
+     * 设置某频段增益
+     *
+     * @param band   频段索引 0..BAND_COUNT-1
+     * @param gainDb 增益（dB），范围约 -15..+15
+     */
+    public void setBandLevel(int band, double gainDb) {
+        if (band < 0 || band >= BAND_COUNT) return;
+        synchronized (lock) {
+            double[] next = new double[BAND_COUNT];
+            System.arraycopy(gainsDb, 0, next, 0, BAND_COUNT);
+            next[band] = gainDb;
+            gainsDb = next;
+            rebuildCoefficientsLocked();
+        }
+    }
+
+    /** 一次性设置全部频段增益（按索引对齐，缺失补 0） */
+    public void setBandLevels(double[] gains) {
+        double[] next = new double[BAND_COUNT];
+        int n = Math.min(BAND_COUNT, gains == null ? 0 : gains.length);
+        for (int i = 0; i < n; i++) next[i] = gains[i];
+        synchronized (lock) {
+            gainsDb = next;
+            rebuildCoefficientsLocked();
+        }
+    }
+
+    /** 在 lock 内重建系数。采样率未确定时先记下增益，等 onConfigure 再建 */
+    private void rebuildCoefficientsLocked() {
+        int fs = activeSampleRate;
+        if (fs <= 0) {
+            coefs = FLAT;
+            return;
+        }
+        double[] gains = gainsDb;
+        if (!enabled || !hasNonZeroGain(gains)) {
+            coefs = FLAT;
+            return;
+        }
+        CoefSet[] built = new CoefSet[BAND_COUNT];
+        for (int i = 0; i < BAND_COUNT; i++) {
+            built[i] = computeCoeffs(BAND_FREQS[i], gains[i], Q, fs);
+        }
+        coefs = built; // volatile 整体替换
+    }
+
+    private static boolean hasNonZeroGain(double[] gains) {
+        for (double g : gains) {
+            if (Math.abs(g) > 1e-6) return true;
+        }
+        return false;
+    }
+
+    /** Audio EQ Cookbook peaking filter，返回归一化（a0=1）系数 */
+    private static CoefSet computeCoeffs(double f0, double dbg, double q, double fs) {
+        double w0 = 2.0 * Math.PI * f0 / fs;
+        double cosW0 = Math.cos(w0);
+        double sinW0 = Math.sin(w0);
+        double a = Math.pow(10.0, dbg / 40.0);
+        double alpha = sinW0 / (2.0 * q);
+
+        double b0 = 1.0 + alpha * a;
+        double b1 = -2.0 * cosW0;
+        double b2 = 1.0 - alpha * a;
+        double a0 = 1.0 + alpha / a;
+        double a1 = -2.0 * cosW0;
+        double a2 = 1.0 - alpha / a;
+
+        return new CoefSet(b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0);
+    }
+
+    @NonNull
+    @Override
+    protected AudioProcessor.AudioFormat onConfigure(AudioProcessor.AudioFormat in) throws AudioProcessor.UnhandledAudioFormatException {
+        if (in.encoding != C.ENCODING_PCM_16BIT && in.encoding != C.ENCODING_PCM_FLOAT) {
+            throw new AudioProcessor.UnhandledAudioFormatException(in);
+        }
+        if (in.channelCount < 1 || in.channelCount > 2) {
+            throw new AudioProcessor.UnhandledAudioFormatException(in);
+        }
+        synchronized (lock) {
+            boolean changed = in.channelCount != channelCount
+                    || in.sampleRate != activeSampleRate
+                    || in.encoding != activeEncoding;
+            if (changed) {
+                channelCount = in.channelCount;
+                activeSampleRate = in.sampleRate;
+                activeEncoding = in.encoding;
+                state = new float[channelCount][BAND_COUNT][2]; // 全 0
+                rebuildCoefficientsLocked();
+            }
+        }
+        return in; // 输出格式与输入一致 → 恒 active
+    }
+
+    @Override
+    public void queueInput(ByteBuffer input) {
+        int remaining = input.remaining();
+        ByteBuffer out = replaceOutputBuffer(remaining);
+        float[][][] st = state;
+        if (st == null || channelCount == 0) {
+            // 未配置时直接透传（media3 正常流程不会进入此分支）
+            out.put(input);
+            out.flip();
+            return;
+        }
+        boolean isFloat = (activeEncoding == C.ENCODING_PCM_FLOAT);
+        int bytesPerSample = isFloat ? 4 : 2;
+        int frames = remaining / (bytesPerSample * channelCount);
+        CoefSet[] c = coefs; // volatile 读一次
+        boolean bypass = (c == FLAT); // 全 0 增益或关闭 → 旁路（仅做格式透传）
+
+        if (!isFloat) {
+            for (int f = 0; f < frames; f++) {
+                for (int ch = 0; ch < channelCount; ch++) {
+                    float x = input.getShort() / 32768.0f;
+                    if (!bypass) x = processChannel(st[ch], c, x);
+                    float clamped = x > 1f ? 1f : (x < -1f ? -1f : x);
+                    out.putShort((short) (clamped * 32767.0f));
+                }
+            }
+        } else {
+            for (int f = 0; f < frames; f++) {
+                for (int ch = 0; ch < channelCount; ch++) {
+                    float x = input.getFloat();
+                    if (!bypass) x = processChannel(st[ch], c, x);
+                    out.putFloat(x);
+                }
+            }
+        }
+        out.flip();
+    }
+
+    /** 串联 20 段 DF2T 处理单声道样本 */
+    private static float processChannel(float[][] chState, CoefSet[] c, float x) {
+        for (int b = 0; b < BAND_COUNT; b++) {
+            CoefSet k = c[b];
+            float[] z = chState[b];
+            float y = k.b0 * x + z[0];
+            z[0] = k.b1 * x - k.a1 * y + z[1];
+            z[1] = k.b2 * x - k.a2 * y;
+            x = y;
+        }
+        return x;
+    }
+
+    @Override
+    protected void onFlush() {
+        clearState();
+    }
+
+    @Override
+    protected void onReset() {
+        synchronized (lock) {
+            channelCount = 0;
+            activeSampleRate = -1;
+            coefs = FLAT;
+        }
+        clearState();
+        state = null;
+    }
+
+    private void clearState() {
+        float[][][] st = state;
+        if (st == null) return;
+        for (int ch = 0; ch < st.length; ch++) {
+            for (int b = 0; b < BAND_COUNT; b++) {
+                st[ch][b][0] = 0f;
+                st[ch][b][1] = 0f;
+            }
+        }
+    }
+}
